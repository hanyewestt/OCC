      traffic_incident_state -->|FK disruption_id| disruption_parent
    end

    subgraph planning[Schema: planning — independent Flyway history]
      planning_request
      diagnosis_result
      recommendation_job
      recommendation
      model_invocation_record
      planning_request -->|FK planning_request_id| diagnosis_result
      diagnosis_result -->|FK diagnosis_id| recommendation_job
      recommendation_job -->|local Planning work| recommendation
      planning_request -. purpose-specific attempt correlation .-> model_invocation_record
      recommendation -. purpose-specific attempt correlation .-> model_invocation_record
    end

    raw_observation -. logical observation ID/snapshot only .-> source_processing_state
