flowchart LR
    subgraph Ingestion[ingestion schema — source of provider/demo facts]
      Poll[poll_run]
      Raw[raw_observation<br/>feed_sequence sequence]
      Arrival[bus_arrival_observation]
      Traffic[traffic_incident_observation]
      Ref[reference_dataset_version]
      Topology[bus_stop / bus_service / bus_route_stop]
      Demo[demo_run / demo_vehicle_assignment]
      Poll --> Raw
      Raw --> Arrival
      Raw --> Traffic
      Ref --> Topology
      Demo --> Arrival
      Demo --> Traffic
    end

    subgraph Disruption[disruption schema — detector and delivery state]
      SourceState[source_processing_state]
      Consumer[consumer_state]
      ProcessState[disruption_processing_state]
      Aggregate[disruption<br/>stable lifecycle ID + kind/scope]
      Event[disruption_event<br/>stable event ID + action]
      Evidence[event_evidence<br/>typed immutable evidence snapshot]
      TrafficState[traffic_incident_state<br/>scoped provider key + freshness]
      Outbox[planning_outbox<br/>idempotency + payload hash + retry/lease]
      ProcessState --> Aggregate
      Aggregate --> Event
      Event --> Evidence
      TrafficState --> Aggregate
      Event --> Outbox
      Consumer --> SourceState
    end

    subgraph Planning[planning schema — durable analysis/result]
      Request[planning_request<br/>producer/event/version dedupe]
      Diagnosis[diagnosis_result<br/>evidence snapshot/hash]
      Job[recommendation_job<br/>retry/lease state]
      Recommendation[recommendation<br/>validated JSON result]
      Invocation[model_invocation_record<br/>purpose: DIAGNOSIS or RECOMMENDATION]
      Request --> Diagnosis
      Diagnosis --> Job
      Job --> Recommendation
      Request -. typed attempt anchor .-> Invocation
      Recommendation -. typed attempt anchor .-> Invocation
    end

    Raw -. API ID + snapshot, no cross-schema FK .-> SourceState
    Arrival -. API ID + snapshot, no cross-schema FK .-> Evidence
    Traffic -. API ID + snapshot, no cross-schema FK .-> Evidence
    Ref -. context API, no cross-schema FK .-> Planning
    Demo -. scoped context API, no identity binding .-> Planning
    Outbox -->|authenticated idempotent submission| Request

    classDef facts fill:#eaf4ff,stroke:#3579b5;
    classDef operations fill:#effbf3,stroke:#39945b;
    classDef results fill:#f1edff,stroke:#7855ae;
    class Poll,Raw,Arrival,Traffic,Ref,Topology,Demo facts;
    class SourceState,Consumer,ProcessState,Aggregate,Event,Evidence,TrafficState,Outbox operations;
    class Request,Diagnosis,Job,Recommendation,Invocation results;
