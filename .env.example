# .env.example
# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- PostgreSQL superuser (init scripts + developer psql only) ---
POSTGRES_DB=occ
POSTGRES_USER=occ_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
OCC_COMPOSE_STARTUP_TIMEOUT_SECONDS=180

# --- Per-schema application users (one per Spring Boot service) ---
# Username is fixed by the init script: occ_ingestion / occ_operations / occ_planning
OCC_INGESTION_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_INGESTION_DB_USERNAME=occ_ingestion
OCC_INGESTION_DB_PASSWORD=change-me
# Host port published by Compose; use this in a browser and host-native clients.
OCC_INGESTION_PORT=6767
# Port on which the ingestion process listens. Compose services use this port directly.
OCC_INGESTION_INTERNAL_PORT=8001
OCC_OPERATIONS_DB_PASSWORD=change-me
# Operations service is started with the optional Compose demo profile.
OCC_OPERATIONS_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_OPERATIONS_DB_USERNAME=occ_operations
OCC_OPERATIONS_PORT=6768
OCC_OPERATIONS_INTERNAL_PORT=8002
OCC_OPERATIONS_JPA_DDL_AUTO=validate
# Enable local API docs; set both to false in shared deployments unless access is controlled.
OCC_OPERATIONS_API_DOCS_ENABLED=true
OCC_OPERATIONS_SWAGGER_UI_ENABLED=true
# Use the issuer URL for your configured Cognito user pool; the example is not a real pool.
OCC_COGNITO_ISSUER_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_example
# Cognito login/roles for Operations. Disabled during prototype development; set true to require access tokens.
OCC_COGNITO_ENABLED=false
OCC_COGNITO_APP_CLIENT_ID=example-app-client-id
# Draft demo fleet pagination limits (items per page).
OCC_DEMO_FLEET_DEFAULT_PAGE_SIZE=50
OCC_DEMO_FLEET_MAX_PAGE_SIZE=200
# Browser basemap provider and required attribution; browser requests visible tiles only.
OCC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OCC_MAP_ATTRIBUTION_TEXT=© OpenStreetMap contributors
OCC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Live observation layer refresh cadence (does not initiate a DataMall poll).
OCC_MAP_REFRESH_INTERVAL=60s
# Prefer source observations on the map until inferred identity matching is validated.
OCC_MAP_RAW_OBSERVATIONS_DEFAULT=true
# A draft vehicle must be within this many metres of a stop on its selected route direction.
OCC_DEMO_ROUTE_MAX_STOP_DISTANCE_METERS=250
# Timeout for Operations requests to Ingestion's reference-topology API.
OCC_OPERATIONS_INGESTION_TIMEOUT=5s
OCC_PLANNING_DB_PASSWORD=change-me

# --- Ingestion runtime settings ---
# Comma-separated service IDs. Missing targets are seeded at startup.
OCC_INGESTION_MONITORED_SERVICES=190,972
OCC_INGESTION_STALE_AFTER_SECONDS=180
OCC_INGESTION_RETENTION=24h
OCC_INGESTION_IMPORT_REFERENCE_ON_STARTUP=true
OCC_INGESTION_SEED_TARGETS_ON_STARTUP=true
OCC_INGESTION_FLYWAY_ENABLED=true
OCC_INGESTION_JPA_DDL_AUTO=validate
OCC_DATAMALL_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice

# --- Bus-bunching runtime settings ---
OCC_BUNCHING_DB_PASSWORD=change-me
OCC_BUNCHING_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_BUNCHING_DB_USER=occ_bunching
OCC_BUNCHING_STALE_AFTER=180s
OCC_BUNCHING_POLL_INTERVAL=30s
OCC_BUNCHING_BATCH_SIZE=100
OCC_BUNCHING_THRESHOLD=90s
OCC_BUNCHING_CONSUMER_ENABLED=true
# Host-native bunching/IDE runs use the published ingestion endpoint.
OCC_INGESTION_PUBLIC_URL=http://localhost:${OCC_INGESTION_PORT}
# Compose-only address supplied by Compose to other services; do not enable for host-native runs.
# OCC_INGESTION_INTERNAL_URL=http://ingestion:8001

# --- External API key (never commit a real value) ---
DATAMALL_API_KEY=change-me

# --- pgAdmin local dashboard ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=6700

# Inferred live bus tracks (Operations; hypotheses only)
# Enable persistent track inference.
OCC_TRACK_INFERENCE_ENABLED=true
# Delay between projection refreshes; no extra DataMall calls.
OCC_TRACK_INFERENCE_INTERVAL=60s
# Startup delay.
OCC_TRACK_INFERENCE_INITIAL_DELAY=5s
# Hide tracks older than this source age.
OCC_TRACK_INFERENCE_STALE_AFTER=180s
# Expire unmatched identities.
OCC_TRACK_INFERENCE_EXPIRY=5m
# Retention for tracks and observation links.
OCC_TRACK_INFERENCE_RETENTION=24h
# Maximum source-time difference for cross-stop clusters.
OCC_TRACK_INFERENCE_CLUSTER_TIME_WINDOW=30s
# Maximum cluster position/progress separation in meters.
OCC_TRACK_INFERENCE_CLUSTER_METERS=60
# Maximum offset from approximate route in meters.
OCC_TRACK_INFERENCE_MAX_ROUTE_OFFSET_METERS=400
# Maximum physically plausible speed.
OCC_TRACK_INFERENCE_MAX_SPEED_METERS_PER_SECOND=25
# Allowed backwards progress noise.
OCC_TRACK_INFERENCE_BACKWARD_TOLERANCE_METERS=80
# Score gap for competing matches.
OCC_TRACK_INFERENCE_AMBIGUITY_MARGIN_METERS=20
# Maximum same-stop ETA change.
OCC_TRACK_INFERENCE_ETA_TOLERANCE=90s
# Upstream observation page size, 1 to 200.
OCC_TRACK_INFERENCE_PAGE_SIZE=200
# Abort above this limit to avoid partial evidence.
OCC_TRACK_INFERENCE_MAX_PAGES=20
