# .env.example
# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- PostgreSQL superuser (init scripts + developer psql only) ---
POSTGRES_DB=occ
POSTGRES_USER=occ_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
OCC_COMPOSE_STARTUP_TIMEOUT_SECONDS=180

# --- Per-schema application users (one per Spring Boot service) ---
# Usernames are fixed by the init scripts: occ_ingestion / occ_operations /
# occ_planning / occ_bunching / occ_recommendation / occ_diagnosis
OCC_INGESTION_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_INGESTION_DB_USERNAME=occ_ingestion
OCC_INGESTION_DB_PASSWORD=change-me
# Optional legacy URL override for host-native ingestion runs; prefer OCC_INGESTION_DB_URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/occ
# Host port published by Compose; use this in a browser and host-native clients.
OCC_INGESTION_PORT=6767
# Port on which the ingestion process listens. Compose services use this port directly.
OCC_INGESTION_INTERNAL_PORT=8001
OCC_OPERATIONS_DB_PASSWORD=change-me
OCC_PLANNING_DB_PASSWORD=change-me
OCC_RECOMMENDATION_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_RECOMMENDATION_DB_USERNAME=occ_recommendation
OCC_RECOMMENDATION_DB_PASSWORD=change-me
OCC_DIAGNOSIS_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_DIAGNOSIS_DB_USERNAME=occ_diagnosis
OCC_DIAGNOSIS_DB_PASSWORD=change-me

# --- Ingestion runtime settings ---
# Comma-separated service IDs. Missing targets are seeded at startup.
OCC_INGESTION_MONITORED_SERVICES=190,972
OCC_INGESTION_STALE_AFTER_SECONDS=180
OCC_INGESTION_RETENTION=3h
# Fixed-rate delay before polling and initial delay before the first poll.
OCC_INGESTION_BUS_ARRIVAL_POLL_INTERVAL=60s
OCC_INGESTION_BUS_ARRIVAL_INITIAL_DELAY=60s
# Retention cleanup fixed delay and initial delay after service startup.
OCC_INGESTION_RETENTION_INTERVAL=1h
OCC_INGESTION_RETENTION_INITIAL_DELAY=5m
OCC_INGESTION_IMPORT_REFERENCE_ON_STARTUP=true
OCC_INGESTION_SEED_TARGETS_ON_STARTUP=true
OCC_INGESTION_FLYWAY_ENABLED=true
OCC_INGESTION_JPA_DDL_AUTO=validate
# Demo support is always available; the persisted runtime state starts disabled and is toggled through /api/v1/demo-mode.
OCC_INGESTION_DEMO_SCENARIO=route190-bunching-v1
OCC_INGESTION_DEMO_SEED=190
OCC_INGESTION_DEMO_STEP_INTERVAL=5s
OCC_BUNCHING_INTERNAL_URL=http://bus-bunching-detection:8002
OCC_BUNCHING_CONTROL_TIMEOUT=5s
# Ingestion's read-only proxy for the completed simulation recommendation.
OCC_RECOMMENDATION_INTERNAL_URL=http://recommendation-engine:8003
OCC_INGESTION_RECOMMENDATION_TIMEOUT=5s
OCC_DATAMALL_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
# Legacy DataMall endpoint alias retained for existing deployments; prefer OCC_DATAMALL_BASE_URL.
DATAMALL_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
# Connect and response-read timeouts for outbound DataMall HTTP calls.
OCC_DATAMALL_CONNECT_TIMEOUT=5s
OCC_DATAMALL_RESPONSE_TIMEOUT=20s

# --- Bus-bunching runtime settings ---
OCC_BUNCHING_DB_PASSWORD=change-me
OCC_BUNCHING_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_BUNCHING_DB_USER=occ_bunching
OCC_BUNCHING_STALE_AFTER=180s
OCC_BUNCHING_POLL_INTERVAL=30s
OCC_BUNCHING_BATCH_SIZE=100
OCC_BUNCHING_THRESHOLD=90s
OCC_BUNCHING_RETRY_DELAY=30s
OCC_BUNCHING_CONSUMER_ENABLED=true
OCC_BUNCHING_INTERNAL_PORT=8002
OCC_BUNCHING_EXPECTED_HEADWAY=600s
OCC_BUNCHING_INGESTION_CONNECT_TIMEOUT=2s
OCC_BUNCHING_INGESTION_RESPONSE_TIMEOUT=5s
# WQAP-2 durable outbox delivery to the root-cause diagnosis service.
OCC_BUNCHING_DIAGNOSIS_INTERNAL_URL=http://root-cause-diagnosis:8004
OCC_BUNCHING_DIAGNOSIS_WORKER_ENABLED=true
OCC_BUNCHING_DIAGNOSIS_DELIVERY_INTERVAL=2s
OCC_BUNCHING_DIAGNOSIS_REQUEST_TIMEOUT=5s
OCC_BUNCHING_DIAGNOSIS_LEASE_DURATION=1m
OCC_BUNCHING_DIAGNOSIS_BATCH_SIZE=10
# Zero means retry transient failures indefinitely with capped backoff.
OCC_BUNCHING_DIAGNOSIS_MAX_ATTEMPTS=0
OCC_BUNCHING_DIAGNOSIS_RETRY_INITIAL_DELAY=2s
OCC_BUNCHING_DIAGNOSIS_RETRY_MAX_DELAY=1m
# Host port for Bunching's public live-alert API and Swagger UI.
OCC_BUNCHING_PORT=6768
# Host-native bunching/IDE runs use the published ingestion endpoint.
OCC_INGESTION_PUBLIC_URL=http://localhost:${OCC_INGESTION_PORT}
OCC_BUNCHING_PUBLIC_URL=http://localhost:${OCC_BUNCHING_PORT}
OCC_INGESTION_INTERNAL_URL=http://ingestion:8001

# --- Recommendation-engine runtime settings ---
# Host port published by Compose; use this in a browser and host-native clients.
OCC_RECOMMENDATION_PORT=6769
# Port on which the recommendation-engine process listens inside its container.
OCC_RECOMMENDATION_INTERNAL_PORT=8003
OCC_RECOMMENDATION_PUBLIC_URL=http://localhost:${OCC_RECOMMENDATION_PORT}
# Spring Resource location of the deterministic mitigation-context fixture.
OCC_RECOMMENDATION_FIXTURE_LOCATION=classpath:fixtures/bunching-mitigation-context.json
# Enables guarded Gemini candidate generation. Leave false when no Gemini key is configured.
OCC_RECOMMENDATION_AI_ENABLED=false
# Gemini Developer API key. Replace only in the ignored .env or deployment secret store.
OCC_RECOMMENDATION_GEMINI_API_KEY=change-me
# Stable Gemini model used for structured mitigation candidates.
OCC_RECOMMENDATION_GEMINI_MODEL=gemini-3.1-flash-lite
OCC_RECOMMENDATION_GEMINI_TEMPERATURE=1.0
OCC_RECOMMENDATION_GEMINI_MAX_OUTPUT_TOKENS=512
# Gemini 3 uses a thinking level rather than the older thinking-budget parameter.
OCC_RECOMMENDATION_GEMINI_THINKING_LEVEL=MINIMAL
OCC_RECOMMENDATION_GEMINI_REQUEST_TIMEOUT=30s
# Total HTTP attempts including the initial Gemini request.
OCC_RECOMMENDATION_GEMINI_RETRY_ATTEMPTS=2
# Maximum accepted recommendation JSON request size and serialized model prompt size, in bytes.
OCC_RECOMMENDATION_MAX_REQUEST_BODY_BYTES=65536
OCC_RECOMMENDATION_MAX_PROMPT_INPUT_BYTES=65536

# --- Root-cause diagnosis (WQAP-3) ---
OCC_DIAGNOSIS_PORT=6770
OCC_DIAGNOSIS_INTERNAL_PORT=8004
OCC_DIAGNOSIS_PUBLIC_URL=http://localhost:${OCC_DIAGNOSIS_PORT}
OCC_DIAGNOSIS_BUNCHING_INTERNAL_URL=http://bus-bunching-detection:8002
OCC_DIAGNOSIS_INGESTION_INTERNAL_URL=http://ingestion:8001
OCC_DIAGNOSIS_RECOMMENDATION_INTERNAL_URL=http://recommendation-engine:8003
OCC_DIAGNOSIS_WORKER_ENABLED=true
OCC_DIAGNOSIS_WORKER_INTERVAL=2s
OCC_DIAGNOSIS_WORKER_BATCH_SIZE=10
OCC_DIAGNOSIS_LEASE_DURATION=5m
OCC_DIAGNOSIS_MAX_ATTEMPTS=3
# Provider processing is bounded; outbound WQAP-4 transient delivery retries default to unlimited.
OCC_DIAGNOSIS_DELIVERY_MAX_ATTEMPTS=0
OCC_DIAGNOSIS_RETRY_INITIAL_DELAY=2s
OCC_DIAGNOSIS_RETRY_MAX_DELAY=1m
OCC_DIAGNOSIS_SCHEMA_REPAIR_ATTEMPTS=1
OCC_DIAGNOSIS_EVIDENCE_LOOKBACK=15m
OCC_DIAGNOSIS_EVIDENCE_RADIUS_KM=2.0
# Descriptive only. Low-confidence diagnoses are still submitted to WQAP-4.
OCC_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.70
OCC_DIAGNOSIS_REQUEST_TIMEOUT=10s
# Maximum decompressed peer response size and serialized provider prompt size, in bytes.
OCC_DIAGNOSIS_PEER_RESPONSE_MAX_BYTES=131072
OCC_DIAGNOSIS_MAX_PROMPT_INPUT_BYTES=65536
OCC_DIAGNOSIS_GEMINI_API_KEY=change-me
OCC_DIAGNOSIS_GEMINI_MODEL=gemini-3.1-flash-lite
OCC_DIAGNOSIS_GEMINI_TEMPERATURE=1.0
OCC_DIAGNOSIS_GEMINI_THINKING_LEVEL=MINIMAL
OCC_DIAGNOSIS_GEMINI_MAX_OUTPUT_TOKENS=1024
OCC_DIAGNOSIS_GEMINI_REQUEST_TIMEOUT=30s
OCC_DIAGNOSIS_GEMINI_RETRY_ATTEMPTS=2
OCC_DIAGNOSIS_SWAGGER_ENABLED=true

# --- External API key (never commit a real value) ---
DATAMALL_API_KEY=replace-with-real-key

# --- Local container readiness probes ---
# Compose HTTP readiness-healthcheck cadence, timeout, retry count and startup grace period.
OCC_HEALTHCHECK_INTERVAL=10s
OCC_HEALTHCHECK_TIMEOUT=3s
OCC_HEALTHCHECK_RETRIES=12
OCC_HEALTHCHECK_START_PERIOD=30s

# --- pgAdmin local dashboard ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=6700
