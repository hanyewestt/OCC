# Copy to the ignored repository-root .env and replace the example secrets.
# This is the local inventory for supported service and Compose settings.

# PostgreSQL database and host port.
POSTGRES_DB=occ
POSTGRES_USER=occ_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Independent passwords for the three schema-owning applications.
OCC_INGESTION_DB_USERNAME=occ_ingestion
OCC_INGESTION_DB_PASSWORD=change-me
OCC_DISRUPTION_DB_USERNAME=occ_disruption
OCC_DISRUPTION_DB_PASSWORD=change-me
OCC_PLANNING_DB_USERNAME=occ_planning
OCC_PLANNING_DB_PASSWORD=change-me
# JDBC destinations for host-native runs; Compose supplies postgres:5432 internally.
OCC_INGESTION_DB_URL=jdbc:postgresql://localhost:5432/occ
OCC_DISRUPTION_DB_PUBLIC_URL=jdbc:postgresql://localhost:5432/occ
OCC_DISRUPTION_DB_INTERNAL_URL=jdbc:postgresql://postgres:5432/occ
OCC_PLANNING_DB_PUBLIC_URL=jdbc:postgresql://localhost:5432/occ
OCC_PLANNING_DB_INTERNAL_URL=jdbc:postgresql://postgres:5432/occ

# Host ports for local browsers/clients; Gateway is the app-facing API entry.
OCC_INGESTION_PORT=6767
OCC_DISRUPTION_PORT=6768
OCC_PLANNING_PORT=6769
OCC_GATEWAY_PORT=6770
# Enable the temporary Supabase password-grant test page in the local Gateway only.
OCC_GATEWAY_AUTH_TEST_ENABLED=true
# Container listener ports. Compose-to-Compose calls use these internal ports.
OCC_INGESTION_INTERNAL_PORT=8001
OCC_DISRUPTION_INTERNAL_PORT=8002
OCC_PLANNING_INTERNAL_PORT=8003
OCC_GATEWAY_INTERNAL_PORT=8004
# Compose DNS URLs. The local Spring profile substitutes the host-facing URLs.
OCC_INGESTION_INTERNAL_URL=http://ingestion:8001
OCC_DISRUPTION_INTERNAL_URL=http://disruption:8002
OCC_PLANNING_INTERNAL_URL=http://planning:8003
OCC_DISRUPTION_PLANNING_INTERNAL_URL=http://planning:8003
OCC_INGESTION_PUBLIC_URL=http://localhost:6767
OCC_DISRUPTION_PUBLIC_URL=http://localhost:6768
OCC_PLANNING_PUBLIC_URL=http://localhost:6769

# Supabase project and JWT validation shared by Gateway and service APIs.
SUPABASE_PROJECT_URL=https://project-ref.supabase.co
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_CLOCK_SKEW=30s
SUPABASE_JWT_ALLOWED_ALGORITHMS=ES256
# Optional one-command OpenAPI export input; leave empty here and set only in the Maven process environment.
OCC_OPENAPI_EXPORT_TOKEN=
# Per-direction private peer capabilities; each setting is shared by its caller and receiver.
OCC_INGESTION_TO_DISRUPTION_PEER_TOKEN=replace-with-random-ingestion-disruption-token
OCC_DISRUPTION_TO_INGESTION_PEER_TOKEN=replace-with-random-disruption-ingestion-token
OCC_INGESTION_TO_PLANNING_PEER_TOKEN=replace-with-random-ingestion-planning-token
OCC_PLANNING_TO_INGESTION_PEER_TOKEN=replace-with-random-planning-ingestion-token
OCC_DISRUPTION_TO_PLANNING_PEER_TOKEN=replace-with-random-disruption-planning-token
OCC_PLANNING_TO_DISRUPTION_PEER_TOKEN=replace-with-random-planning-disruption-token

# LTA DataMall endpoint, API credential, and outbound HTTP bounds.
DATAMALL_API_KEY=replace-with-your-datamall-key
OCC_DATAMALL_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
OCC_DATAMALL_CONNECT_TIMEOUT=5s
OCC_DATAMALL_RESPONSE_TIMEOUT=20s

# Ingestion arrival polling, retention, reference loading, traffic feed and simulation.
OCC_INGESTION_MONITORED_SERVICES=190,972
OCC_INGESTION_STALE_AFTER_SECONDS=180
OCC_INGESTION_RETENTION=12h
OCC_INGESTION_BUS_ARRIVAL_POLL_INTERVAL=60s
OCC_INGESTION_BUS_ARRIVAL_INITIAL_DELAY=60s
OCC_INGESTION_RETENTION_INTERVAL=1h
OCC_INGESTION_RETENTION_INITIAL_DELAY=5m
OCC_INGESTION_IMPORT_REFERENCE_ON_STARTUP=true
OCC_INGESTION_SEED_TARGETS_ON_STARTUP=true
OCC_INGESTION_FLYWAY_ENABLED=true
OCC_INGESTION_JPA_DDL_AUTO=validate
OCC_INGESTION_TRAFFIC_POLL_PAGE_SIZE=100
OCC_INGESTION_TRAFFIC_POLL_MAX_PAGE_SIZE=250
OCC_INGESTION_DEMO_SCENARIO=route190-bunching-v1
OCC_INGESTION_DEMO_SEED=190
OCC_INGESTION_DEMO_STEP_INTERVAL=5s
OCC_INGESTION_DEMO_BUNCHING_THRESHOLD=90s
OCC_INGESTION_DISRUPTION_TIMEOUT=5s
OCC_INGESTION_PLANNING_TIMEOUT=5s

# Disruption detection thresholds, consumer cadence, planning outbox and traffic incident lifecycle.
OCC_DISRUPTION_CONSUMER_ENABLED=true
OCC_DISRUPTION_THRESHOLD=90s
OCC_DISRUPTION_STALE_AFTER=120s
OCC_DISRUPTION_POLL_INTERVAL=1s
OCC_DISRUPTION_BATCH_SIZE=100
OCC_DISRUPTION_RETRY_DELAY=30s
OCC_DISRUPTION_EXPECTED_HEADWAY=600s
OCC_DISRUPTION_INGESTION_CONNECT_TIMEOUT=2s
OCC_DISRUPTION_INGESTION_RESPONSE_TIMEOUT=5s
OCC_DISRUPTION_RETENTION_INTERVAL=1h
OCC_DISRUPTION_RETENTION_INITIAL_DELAY=5m
OCC_DISRUPTION_PLANNING_WORKER_ENABLED=true
OCC_DISRUPTION_PLANNING_DELIVERY_INTERVAL=2s
OCC_DISRUPTION_PLANNING_REQUEST_TIMEOUT=5s
OCC_DISRUPTION_PLANNING_LEASE_DURATION=1m
OCC_DISRUPTION_PLANNING_BATCH_SIZE=10
OCC_DISRUPTION_PLANNING_MAX_ATTEMPTS=0
OCC_DISRUPTION_PLANNING_RETRY_INITIAL_DELAY=2s
OCC_DISRUPTION_PLANNING_RETRY_MAX_DELAY=1m
OCC_DISRUPTION_TRAFFIC_POLL_ENABLED=true
OCC_DISRUPTION_TRAFFIC_POLL_INTERVAL=10s
OCC_DISRUPTION_TRAFFIC_POLL_PAGE_SIZE=100
OCC_DISRUPTION_TRAFFIC_STALE_AFTER=5m
OCC_DISRUPTION_TRAFFIC_CLEAR_AFTER_SUCCESSFUL_ABSENCES=2

# Planning workers, evidence bounds, response limits and deterministic/Gemini recommendations.
OCC_PLANNING_RECOMMENDATION_AUDIT_MAX_RESPONSE_CHARACTERS=65536
OCC_PLANNING_RECOMMENDATION_MAX_PROMPT_INPUT_BYTES=65536
OCC_PLANNING_RECOMMENDATION_AI_ENABLED=false
OCC_PLANNING_RECOMMENDATION_FIXTURE_LOCATION=classpath:fixtures/bunching-mitigation-context.json
OCC_PLANNING_GEMINI_API_KEY=
OCC_PLANNING_GEMINI_MODEL=gemini-3.1-flash-lite
OCC_PLANNING_GEMINI_TEMPERATURE=1.0
OCC_PLANNING_RECOMMENDATION_GEMINI_MAX_OUTPUT_TOKENS=512
OCC_PLANNING_GEMINI_THINKING_LEVEL=MINIMAL
OCC_PLANNING_GEMINI_REQUEST_TIMEOUT=30s
OCC_PLANNING_GEMINI_RETRY_ATTEMPTS=2
OCC_PLANNING_DIAGNOSIS_RETENTION_INTERVAL=1h
OCC_PLANNING_DIAGNOSIS_RETENTION_INITIAL_DELAY=5m
OCC_PLANNING_DIAGNOSIS_AUDIT_MAX_RESPONSE_CHARACTERS=65536
OCC_PLANNING_DIAGNOSIS_WORKER_ENABLED=true
OCC_PLANNING_DIAGNOSIS_WORKER_INTERVAL=2s
OCC_PLANNING_DIAGNOSIS_WORKER_BATCH_SIZE=10
OCC_PLANNING_DIAGNOSIS_LEASE_DURATION=5m
OCC_PLANNING_DIAGNOSIS_MAX_ATTEMPTS=3
OCC_PLANNING_DIAGNOSIS_DELIVERY_MAX_ATTEMPTS=0
OCC_PLANNING_DIAGNOSIS_RETRY_INITIAL_DELAY=2s
OCC_PLANNING_DIAGNOSIS_RETRY_MAX_DELAY=1m
OCC_PLANNING_DIAGNOSIS_EVIDENCE_LOOKBACK=15m
OCC_PLANNING_DIAGNOSIS_EVIDENCE_RADIUS_KM=2.0
OCC_PLANNING_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.70
OCC_PLANNING_DIAGNOSIS_REQUEST_TIMEOUT=10s
OCC_PLANNING_DIAGNOSIS_PEER_RESPONSE_MAX_BYTES=131072
OCC_PLANNING_DIAGNOSIS_MAX_PROMPT_INPUT_BYTES=65536
OCC_PLANNING_DIAGNOSIS_GEMINI_MAX_OUTPUT_TOKENS=1024
OCC_PLANNING_SWAGGER_ENABLED=true

# Local Compose health checks and optional pgAdmin dashboard.
OCC_HEALTHCHECK_INTERVAL=10s
OCC_HEALTHCHECK_TIMEOUT=3s
OCC_HEALTHCHECK_RETRIES=12
OCC_HEALTHCHECK_START_PERIOD=30s
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=6700
