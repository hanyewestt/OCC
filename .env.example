# Shared local configuration. Copy to .env at the repository root.
# Use unquoted values: both Docker Compose and Java properties read this file.
POSTGRES_DB=occ
POSTGRES_USER=occ_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
OCC_INGESTION_DB_PASSWORD=change-me
OCC_OPERATIONS_DB_PASSWORD=change-me
OCC_PLANNING_DB_PASSWORD=change-me
DATAMALL_API_KEY=replace-with-your-datamall-key

# Optional local pgAdmin dashboard (--profile tools).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# Optional external database override for ingestion:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/occ
