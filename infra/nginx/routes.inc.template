    absolute_redirect off;
    client_max_body_size 1m;
    resolver 127.0.0.11 valid=30s ipv6=off;
    # Trusted client identity and viewer protocol. The TLS and local edges
    # keep the socket address and $scheme; the CloudFront origin overrides
    # both with CloudFront's unforgeable injected headers after its gate.
    set $occ_client_ip $remote_addr;
    set $occ_forwarded_proto $scheme;
    # Resolve each backend at request time so replacing a container's address
    # never leaves Nginx pinned to a stale upstream.
    set $occ_ingestion_upstream ${OCC_INGESTION_INTERNAL_URL};
    set $occ_disruption_upstream ${OCC_DISRUPTION_INTERNAL_URL};
    set $occ_planning_upstream ${OCC_PLANNING_INTERNAL_URL};

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Idempotency-Key $http_idempotency_key;
    proxy_set_header X-Correlation-ID $request_id;
    proxy_set_header X-Real-IP $occ_client_ip;
    proxy_set_header X-Forwarded-For $occ_client_ip;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $occ_forwarded_proto;
    proxy_set_header Forwarded "";
    proxy_set_header X-OCC-Peer-Token "";
    proxy_set_header X-OCC-Origin-Secret "";

    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location = /_occ_edge_health {
        access_log off;
        return 204;
    }

    location = /internal {
        return 404;
    }

    location ^~ /internal/ {
        return 404;
    }

    location = /actuator {
        return 404;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location ^~ /v3/ {
        return 404;
    }

    location = /swagger-ui.html {
        return 404;
    }

    location ^~ /swagger-ui/ {
        return 404;
    }

    location ^~ /webjars/ {
        return 404;
    }

    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;

    location = / { try_files /index.html =404; }
    location = /index.html { try_files $uri =404; }
    location = /login { try_files /index.html =404; }
    location = /controller { try_files /index.html =404; }
    location = /controller/disruptions { try_files /index.html =404; }
    location = /controller/planning { try_files /index.html =404; }
    location = /controller/notices { try_files /index.html =404; }
    location = /controller/audit { try_files /index.html =404; }
    location = /captain { try_files /index.html =404; }
    location = /notices { try_files /index.html =404; }
    location = /401 { try_files /index.html =404; }
    location = /403 { try_files /index.html =404; }
    location = /404 { try_files /index.html =404; }
    location ^~ /assets/ { try_files $uri =404; }
    location = /404.html { internal; try_files $uri =404; }

    # Public bootstrap configuration is owned by Ingestion.
    location = /frontend-config {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_ingestion_upstream;
    }

    # Verified session and page-access checks are owned by Ingestion.
    location = /api/v1/auth/session {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_ingestion_upstream;
    }

    location ^~ /api/v1/auth/access/ {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_ingestion_upstream;
    }

    # The relocated authentication endpoints must never become reachable through
    # an unintended Ingestion prefix alias such as /api/v1/ingestion/auth/session.
    location ^~ /api/v1/ingestion/auth/ {
        return 404;
    }

    # Re-enter location selection so this supported alias shares the canonical
    # stream's buffering and timeout policy, including its query parameters.
    location = /api/v1/ingestion/pacing-snapshots/stream {
        rewrite ^ /api/v1/pacing-snapshots/stream last;
    }

    # Ingestion's public namespace strips the /ingestion segment.
    location ^~ /api/v1/ingestion/ {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        rewrite ^/api/v1/ingestion/(.*)$ /api/v1/$1 break;
        proxy_pass $occ_ingestion_upstream;
    }

    # Disruption's public namespace is forwarded unchanged.
    location ^~ /api/v1/disruption/ {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_disruption_upstream;
    }

    # Planning's public namespace is forwarded unchanged.
    location ^~ /api/v1/planning/ {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_planning_upstream;
    }

    # Pacing streams are Server-Sent Events: never buffer them and let the
    # application's 30m stream timeout close the connection before Nginx.
    location = /api/v1/pacing-snapshots/stream {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 35m;
        proxy_send_timeout 35m;
        proxy_pass $occ_ingestion_upstream;
    }

    # Remaining versioned APIs keep their paths and are owned by Ingestion.
    location ^~ /api/v1/ {
        limit_req zone=occ_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $occ_ingestion_upstream;
    }

    location / {
        error_page 404 /404.html;
        return 404;
    }
