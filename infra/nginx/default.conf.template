# Rate limiting keys on the trusted client identity variable that the shared
# routes define: the socket address on direct TLS, the CloudFront viewer
# behind the edge.
limit_req_zone $occ_client_ip zone=occ_api:10m rate=20r/s;

server {
    listen ${OCC_NGINX_HTTPS_INTERNAL_PORT} ssl;
    http2 on;
    server_name ${OCC_NGINX_SERVER_NAME};
    server_tokens off;

    ssl_certificate /run/secrets/occ_tls_certificate;
    ssl_certificate_key /run/secrets/occ_tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/conf.d/routes.inc;

    location = /auth-test { return 404; }
    location ^~ /auth-test/ { return 404; }
}
