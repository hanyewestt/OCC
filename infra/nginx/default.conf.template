limit_req_zone $binary_remote_addr zone=occ_api:${OCC_NGINX_RATE_LIMIT_ZONE_SIZE} rate=${OCC_NGINX_RATE_LIMIT_PER_SECOND};

server {
    listen 8443 ssl;
    http2 on;
    server_name ${OCC_NGINX_SERVER_NAME};
    server_tokens off;

    ssl_certificate /run/secrets/occ_tls_certificate;
    ssl_certificate_key /run/secrets/occ_tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size ${OCC_NGINX_CLIENT_MAX_BODY_SIZE};
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $occ_gateway_upstream ${OCC_GATEWAY_INTERNAL_URL};

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Idempotency-Key $http_idempotency_key;
    proxy_set_header X-Correlation-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_set_header X-OCC-Peer-Token "";

    proxy_connect_timeout ${OCC_NGINX_PROXY_CONNECT_TIMEOUT};
    proxy_read_timeout ${OCC_NGINX_PROXY_READ_TIMEOUT};
    proxy_send_timeout ${OCC_NGINX_PROXY_SEND_TIMEOUT};

    location = /_occ_edge_health {
        access_log off;
        return 204;
    }

    location = /internal {
        return 404;
    }

    location ^~ /internal/ {
        return 404;
    }

    location = /actuator {
        return 404;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location ^~ /v3/api-docs {
        return 404;
    }

    location = /swagger-ui.html {
        return 404;
    }

    location ^~ /swagger-ui/ {
        return 404;
    }

    location = /auth-test {
        return 404;
    }

    location ^~ /auth-test/ {
        return 404;
    }

    location = /demo.html {
        proxy_pass $occ_gateway_upstream;
    }

    location ^~ /api/v1/ {
        limit_req zone=occ_api burst=${OCC_NGINX_RATE_LIMIT_BURST} nodelay;
        limit_req_status 429;
        proxy_pass $occ_gateway_upstream;
    }

    location / {
        return 404;
    }
}
