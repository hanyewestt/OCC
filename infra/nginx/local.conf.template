limit_req_zone $binary_remote_addr zone=occ_api:${OCC_NGINX_RATE_LIMIT_ZONE_SIZE} rate=${OCC_NGINX_RATE_LIMIT_PER_SECOND};

server {
    listen ${OCC_NGINX_HTTP_INTERNAL_PORT};
    server_name ${OCC_NGINX_SERVER_NAME};
    server_tokens off;
    include /etc/nginx/conf.d/routes.inc;

    location = /auth-test { return 302 /auth-test/; }
    location = /auth-test/ { try_files /auth-test/index.html =404; }
    location = /auth-test/index.html { try_files $uri =404; }
    location = /auth-test/callback { try_files /auth-test/index.html =404; }
}
