# infra/local/.env.example
# Copy to infra/local/.env and fill in. Never commit .env (see .gitignore).

# --- PostgreSQL superuser (init scripts + developer psql only) ---
POSTGRES_DB=occ
POSTGRES_USER=occ_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Per-schema application users (one per Spring Boot service) ---
# Username is fixed by the init script: occ_ingestion / occ_operations / occ_planning
OCC_INGESTION_DB_PASSWORD=change-me
OCC_OPERATIONS_DB_PASSWORD=change-me
OCC_PLANNING_DB_PASSWORD=change-me

# --- External API key (never commit a real value) ---
DATAMALL_API_KEY=replace-with-your-datamall-key

# --- What each service puts in its own application.yml / env ---
# spring.datasource.url=jdbc:postgresql://localhost:5432/occ
# spring.datasource.username=occ_ingestion         (or occ_operations / occ_planning)
# spring.datasource.password=${OCC_INGESTION_DB_PASSWORD}
# spring.flyway.default-schema=ingestion            (or operations / planning)
# spring.jpa.hibernate.ddl-auto=none                (mandatory — see README "Database ownership")
