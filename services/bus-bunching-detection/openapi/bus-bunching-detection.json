{"openapi":"3.1.0","info":{"title":"OCC Bus Bunching Detection API","description":"Internal feed selection and simulation alert APIs for bus bunching detection.","version":"v1"},"servers":[{"url":"http://localhost:6768","description":"Generated server url"}],"paths":{"/internal/v1/consumer-selection":{"put":{"tags":["Bunching consumer"],"summary":"Select exactly one live or simulation feed","operationId":"selectBunchingConsumer","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SelectConsumerRequest"}}},"required":true},"responses":{"204":{"description":"Consumer feed selection changed"},"400":{"description":"The mode and run ID combination is invalid"}}}},"/internal/v1/demo-runs/{demoRunId}/alerts":{"get":{"tags":["Demo runs (internal)"],"summary":"List simulation-only alert events for one demo run","operationId":"listSimulationBunchingAlerts","parameters":[{"name":"demoRunId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Simulation alerts returned, possibly an empty list","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AlertPage"}}}}}}},"/api/v1/live-bunching-alerts":{"get":{"tags":["Live bunching alerts"],"summary":"List currently open bunching detections from the live feed","operationId":"listCurrentLiveBunchingAlerts","parameters":[{"name":"page","in":"query","description":"Zero-based page number","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","description":"Maximum alerts per page (1-200)","required":false,"schema":{"type":"integer","format":"int32","default":50,"maximum":200,"minimum":1}}],"responses":{"200":{"description":"Current live alerts returned, possibly empty","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LiveBunchingAlertPageResponse"}}}}}}}},"components":{"schemas":{"SelectConsumerRequest":{"type":"object","properties":{"mode":{"type":"string","minLength