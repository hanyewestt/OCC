Request"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}}}}},"/api/v1/planning/advisories/{id}/decisions":{"post":{"tags":["Captain advisories"],"summary":"Approve or replace a structured advisory and issue it","description":"Controller/admin only. Actor comes from JWT. Identical repeated decisions return the original instruction; conflicting decisions return 409. Overrides require a rationale. Explicit replaceInstructionId cancels a conflicting movement instruction atomically.","operationId":"decideAdvisory","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DecideAdvisoryRequest"}}},"required":true},"responses":{"200":{"description":"Issued instruction or identical replay","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstructionResponse"}}}},"400":{"description":"Invalid structured parameters","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstructionResponse"}}}},"404":{"description":"Proposal not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstructionResponse"}}}},"409":{"description":"Scope, evidence or movement conflict","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstructionResponse"}}}}}}},"/api/v1/planning/recommendations/pending":{"get":{"tags":["Planning recommendations"],"summary":"List recommendations for the active simulation awaiting a controller decision","operationId":"listPendingBunchingRecommendations","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":50}}],"responses":{"200":{"description":"Pending recommendations for the selected run; empty in Live mode","content":{"*/*":{"schema":{"$ref":"#/componen