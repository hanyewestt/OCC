{"openapi":"3.1.0","info":{"title":"OCC Planning API","description":"Diagnosis and validated mitigation recommendations for operational disruptions.","version":"1.0.0"},"servers":[{"url":"http://localhost:6769","description":"Generated server url"}],"paths":{"/internal/v1/planning/requests":{"post":{"tags":["Root-cause diagnosis requests"],"summary":"Queue diagnosis for an immutable producer event","description":"The producer submits versioned immutable event facts. Planning stores the input before acknowledging. Bunching events are enriched from Ingestion; traffic incident events receive the explicit phase-1 no-action policy.","operationId":"createDiagnosisRequest","parameters":[{"name":"Idempotency-Key","in":"header","description":"UUID reused when retrying this producer event","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-OCC-Event-Fingerprint","in":"header","description":"Lowercase SHA-256 fingerprint of the canonical typed event envelope","required":true,"schema":{"type":"string","pattern":"[0-9a-f]{64}"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateDiagnosisEventSubmission"}}},"required":true},"responses":{"202":{"description":"Diagnosis request accepted or an existing request was returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DiagnosisRequestResponse"}}}},"400":{"description":"Request validation failed, including a missing or invalid idempotency key or event fingerprint","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"The idempotency key or event identity has different immutable facts","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"422":{"description":"Event type is unsupported or its evidence snapshot cannot be captured","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"503":{"description":"Temporary dependency failure while capturing the event evidence snapshot","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/planning/recommendations/{recommendationId}/decision":{"get":{"tags":["Planning recommendations"],"summary":"Get a recommendation's saved controller decision","operationId":"getBunchingRecommendationDecision","parameters":[{"name":"recommendationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Saved decision returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}},"204":{"description":"Recommendation has not been reviewed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}},"404":{"description":"Recommendation not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}}}},"post":{"tags":["Planning recommendations"],"summary":"Approve or replace a recommendation","description":"The first decision is stored with the authenticated controller subject. A rejection requires one to three replacement bus instructions and a rationale. Repeating the same complete decision is safe; changing it returns 409. A decision records controller intent only and does not dispatch a bus instruction.","operationId":"decideBunchingRecommendation","parameters":[{"name":"recommendationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionRequest"}}},"required":true},"responses":{"200":{"description":"Decision stored or the same decision replayed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}},"400":{"description":"Decision request is invalid","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}},"404":{"description":"Recommendation not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}},"409":{"description":"A different or ineligible decision was supplied","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RecommendationDecisionResponse"}}}}}}},"/api/v1/planning/recommendations/{id}/obu-decisions":{"post":{"tags":["bunching-instruction-controller"],"summary":"Approve and issue a validated HOLD/DWELL instruction atomically","description":"Controller/admin only. No body or free-text override. Revalidates existing safety rules, active run, unique recipient and upcoming control stop; repeated issuance returns the original instruction. Movement conflicts return 409.","operationId":"approveBunchingObuInstruction","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstructionResponse"}}}}}}},"/api/v1/planning/notices":{"get":{"tags":["Public advisories"],"summary":"Review notice drafts and publication history","description":"Controller/admin only; newest first; page 0, size 20 (1–100).","operationId":"listManagedNotices","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponse"}}}}}},"post":{"tags":["Public advisories"],"summary":"Create a controller-reviewed notice draft","description":"Controller/admin only. Client UUID identifies an idempotent draft; different content under the same UUID returns 409. Source determines provenance; actor comes from JWT.","operationId":"draftNotice","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateNoticeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NoticeResponse"}}}}}}},"/api/v1/planning/notices/{id}/withdrawals":{"post":{"tags":["Public advisories"],"summary":"Withdraw a public notice","description":"Controller/admin only. Repeated withdrawal is safe; public reads exclude it immediately.","operationId":"withdrawNotice","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NoticeResponse"}}}}}}},"/api/v1/planning/notices/{id}/suggestions":{"post":{"tags":["Public advisories"],"summary":"Suggest passenger-facing notice text for controller review","description":"Controller/admin only. Uses deterministic source facts when AI is disabled; enabled AI receives no bus, captain, account or run identifiers. This endpoint never creates or publishes a notice.","operationId":"suggestNoticeText","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NoticeSuggestionResponse"}}}}}}},"/api/v1/planning/notices/{id}/replacements":{"post":{"tags":["Public advisories"],"summary":"Publish a correction and withdraw the old notice atomically","description":"Controller/admin only. New UUID and same disruption source required. Repeating the same replacement is idempotent.","operationId":"replaceNotice","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateNoticeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NoticeResponse"}}}}}}},"/api/v1/planning/notices/{id}/publications":{"post":{"tags":["Public advisories"],"summary":"Publish an approved notice","description":"Cont