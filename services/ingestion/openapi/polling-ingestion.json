        "summary": "Get all ordered stop sequences for a bus service",
        "operationId": "getBusRoute",
        "parameters": [
          {
            "name": "serviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BusRouteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arrivals": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "List latest arrival predictions by stop or service",
        "operationId": "listCurrentArrivals",
        "parameters": [
          {
            "name": "stopCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serviceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseArrivalResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arrivals/history": {
      "get": {
        "tags": [
          "Ingestion"
