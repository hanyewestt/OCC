                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/arrival-snapshots": {
      "get": {
        "tags": [
          "Bunching ingestion"
        ],
        "summary": "List normalized snapshots for bunching",
        "operationId": "listBunchingArrivalSnapshots",
        "parameters": [
          {
            "name": "afterSequence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "maximum": 1000,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BunchingSnapshotPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/arrival-snapshots/{rawObservationId}": {
      "get": {
        "tags": [
          "Bunching ingestion"
        ],
        "summary": "Get one normalized snapshot for retry",
        "operationId": "getBunchingArrivalSnapshot",
        "parameters": [
          {
            "name": "rawObservationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BunchingSnapshotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/observed-buses": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "List usable DataMall arrival positions for a map",
        "description": "Returns source-monitored arrival slots with usable coordinates from each target's latest successful poll. Each item is an observation, not a verified vehicle identity. Stale items must not be presented as current bus positions. No plate, driver, or inferred track is returned.",
        "operationId": "listObservedBusPositions",
        "parameters": [
          {
            "name": "serviceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated unverified arrival positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedBusPositionPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
