{
  "openapi": "3.1.0",
  "info": {
    "title": "OCC Ingestion API",
    "description": "Read-only access to normalized DataMall bus-arrival ingestion data.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/v1/reference-topology": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Get the active DataMall topology version",
        "operationId": "activeReferenceTopology",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceTopologyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/poll-runs": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "List polling audit runs",
        "operationId": "listPollRuns",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponsePollRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feed-status": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "List polling health for each configured stop",
        "operationId": "listFeedStatuses",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedStatusResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bus-stops": {
      "get": {
        "tags": [
          "Reference topology"
        ],
        "summary": "List bus stops in the active reference topology",
        "operationId": "listBusStops",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseBusStopResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bus-stops/{stopCode}": {
      "get": {
        "tags": [
          "Reference topology"
        ],
        "summary": "Get a bus stop by stop code",
        "operationId": "getBusStop",
        "parameters": [
          {
            "name": "stopCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BusStopResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bus-routes": {
      "get": {
        "tags": [
          "Reference topology"
        ],
        "summary": "List bus routes in the active reference topology",
