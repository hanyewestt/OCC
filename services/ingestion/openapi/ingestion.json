{"openapi":"3.1.0","info":{"title":"OCC Ingestion API","description":"DataMall ingestion APIs and runtime-toggleable simulation-only bunching demo APIs.","version":"v1"},"servers":[{"url":"http://localhost:6767","description":"Generated server url"}],"tags":[{"name":"Pacing","description":"Gap to the bus ahead and behind for bus captain On Board Units. Readable by ADMIN, CONTROLLER and CAPTAIN."}],"paths":{"/api/v1/demo-mode":{"get":{"tags":["Demo mode"],"summary":"Read the persisted runtime demo setting","operationId":"getDemoMode","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeResponse"}}}}}},"put":{"tags":["Demo mode"],"summary":"Start or stop simulation bunching without restarting ingestion","description":"Enabling starts or resumes the active simulation run. Disabling switches bunching to the live feed and closes the active run.","operationId":"setDemoMode","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeRequest"}}},"required":true},"responses":{"200":{"description":"Runtime demo mode changed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeResponse"}}}},"400":{"description":"The enabled field is required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeResponse"}}}},"409":{"description":"Another demo run is active","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeResponse"}}}},"503":{"description":"Bunching control is unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoModeResponse"}}}}}}},"/api/v1/demo-runs":{"post":{"tags":["Demo runs"],"summary":"Start a deterministic simulation bunching run","operationId":"startDemoRun","responses":{"201":{"description":"Demo run started","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRunResponse"}}}},"409":{"description":"A demo run is already active","content"