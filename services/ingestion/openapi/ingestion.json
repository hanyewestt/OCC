":"Invalid pagination or sort parameters","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/arrivals/history":{"get":{"tags":["Ingestion"],"summary":"List retained normalized arrival observations","operationId":"listArrivalHistory","parameters":[{"name":"stopCode","in":"query","required":false,"schema":{"type":"string"}},{"name":"serviceId","in":"query","required":false,"schema":{"type":"string"}},{"name":"from","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"to","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":50,"maximum":200,"minimum":1}}],"responses":{"200":{"description":"Arrival history returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArrivalPageResponse"}}}},"400":{"description":"Invalid pagination parameters or time range","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}}},"components":{"schemas":{"DemoModeRequest":{"type":"object","properties":{"enabled":{"type":"boolean"}},"required":["enabled"]},"DemoModeResponse":{"type":"object","properties":{"enabled":{"type":"boolean"}}},"DemoBunchingAlertResponse":{"type":"object","description":"Bunching transition detected from simulation observations","properties":{"eventId":{"type":"string","format":"uuid"},"bunchingEventId":{"type":"string","format":"uuid"},"action":{"type":"string"},"classification":{"type":"string"},"serviceId":{"type":"string"},"stopCode":{"type":"string"},"stopName":{"type":"string"},"stopRoadName":{"type":"string"},"directionId":{"type":"integer","format":"int32"},"detectedAt":{"type":"string","format":"date-time"},"headwaySeconds":{"type":["integer","null"],"format":"int64",