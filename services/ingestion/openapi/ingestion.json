:"query","required":true,"schema":{"type":"string"}},{"name":"stopCode","in":"query","required":true,"schema":{"type":"string"}},{"name":"directionId","in":"query","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"arrivalObservationIds","in":"query","description":"Two to ten WQAP-2-owned arrival observation IDs","required":true,"schema":{"type":"array","items":{"type":"string","format":"uuid"}}}],"responses":{"200":{"description":"Simulation-scoped evidence context","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RootCauseContextResponse"}}}},"400":{"description":"Evidence observations do not match the simulation event","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Demo run not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RootCauseContextResponse"}}}}}}},"/internal/v1/ingestion/demo-fleet":{"get":{"tags":["Demo fleet"],"summary":"Read current simulation assignments and progress","description":"Requires the Planning or Disruption peer capability. Closed/preparing runs return no current buses. page defaults to 0; size defaults to 20 and is bounded to 1–100; sorted by busId.","operationId":"getDemoFleet","parameters":[{"name":"demoRunId","in":"query","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"Simulation fleet page","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoFleetResponse"}}}},"400":{"description":"Invalid pagination or run identity","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoFleetResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoFleetResponse"}}}},"403":{"description":"Peer capability required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoFleetResponse"}}}},"404":{"description":"Run not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoFleetResponse"}}}}}}},"/internal/v1/ingestion/bus-routes/{serviceId}":{"get":{"tags":["hazard-reference-controller"],"summary":"Read route occurrences for hazard association","description":"Planning/Disruption peer capability required. Same topology as controller route reads.","operationId":"getHazardRouteReference","parameters":[{"name":"serviceId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BusRouteResponse"}}}}}}},"/internal/v1/hazard-polls":{"get":{"tags":["hazard-poll-controller"],"summary":"Consume completed hazard polls","description":"Disruption peer only. kind selects an independent feed; paired afterCompletedAt/afterPollRunId cursor. limit defaults to 20, range 1–100. Traffic uses its existing endpoint. Incomplete polls never establish absence.","operationId":"listHazardPolls","parameters":[{"name":"kind","in":"query","required":true,"schema":{"type":"string","enum":["TRAFFIC_INCIDENT","FLOOD","RAIL_DISRUPTION","ROADWORKS"]}},{"name":"afterCompletedAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"afterPollRunId","in":"query","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"Polls ordered by completion time and UUID","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HazardPollPageResponse"}}}},"400":{"description":"Invalid kind, cursor or limit","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HazardPollPageResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HazardPollPageResponse"}}}},"403":{"description":"Disruption peer required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HazardPollPageResponse"}}}}}}},"/internal/v1/demo-runs/{demoRunId}/arrival-snapshots":{"get":{"tags":["demo-snapshot-controller"],"operationId":"page","parameters":[{"name":"demoRunId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"afterSequence","in":"query","required":false,"schema":{"type":"integer","format":"int64","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":100}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BunchingSnapshotPageResponse"}}}}}}},"/internal/v1/demo-runs/{demoRunId}/arrival-snapshots/{rawObservationId}":{"get":{"tags":["demo-snapshot-controller"],"operationId":"snapshot","parameters":[{"name":"demoRunId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"rawObservationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BunchingSnapshotResponse"}}}}}}},"/internal/v1/arrival-snapshots":{"get":{"tags":["Bunching ingestion"],"summary":"List normalized snapshots for bunching","operationId":"listBunchingArrivalSnapshots","parameters":[{"name":"afterSequence","in":"query","required":false,"schema":{"type":"integer","format":"int64","default":0,"minimum":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":100,"maximum":1000,"minimum":1}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BunchingSnapshotPageResponse"}}}}}}},"/internal/v1/arrival-snapshots/{rawObservationId}":{"get":{"tags":["Bunching ingestion"],"summary":"Get one normalized snapshot for retry","operationId":"getBunchingArrivalSnapshot","parameters":[{"name":"rawObservationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BunchingSnapshotResponse"}}}}}}},"/internal/v1/arrival-snapshots/head":{"get":{"tags":["Bunching ingestion"],"summary":"Get the current live snapshot sequence","operationId":"getBunchingLiveFeedHead","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BunchingFeedHeadResponse"}}}}}}},"/api/v1/route-positions":{"get":{"tags":["Route positions"],"summary":"Estimate bus positions from recent route observations","description":"Returns direction-scoped positions from the newest completed eligible provider poll cycle. On configured service directions, compatible non-cooccurring coordinate versions may be linked, but estimates returned together by one stop snapshot remain separate. Coordinated refresh-boundary matching is enabled only for configured service directions. On configured circular service directions, evidence can share a compatible phase without reducing the number of estimates. Evidence IDs and sourcePollCycleId identify source records, not verified physical vehicles; sourceObservedAt is source time while computedAt is response computation time.","operationId":"getRoutePositions","parameters":[{"name":"service","in":"query","required":true,"schema":{"type":"string","maxLength":20,"minLength":0}}],"responses":{"200":{"description":"Estimated positions returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RoutePositionsResponse"}}}},"400":{"description":"Invalid or missing service ID","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Service or active route topology not found","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/reference-topology":{"get":{"tags":["Ingestion"],"summary":"Get the active DataMall topology version","operationId":"activeReferenceTopology","responses":{"404":{"description":"No active reference topology","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/poll-runs":{"get":{"tags":["Ingestion"],"summary":"List polling audit runs","operationId":"listPollRuns","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":50,"maximum":200,"minimum":1}}],"responses":{"400":{"description":"Invalid pagination parameters","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/pacing-snapshots/stream":{"get":{"tags":["Pacing"],"summary":"Stream pacing snapshots as Server-Sent Events","description":"Pushes the current snapshot immediately, then one `pacing` event per calculation cycle (every 10 seconds by default). Each event's data is a PacingSnapshotResponse. The server closes the stream after the configured timeout; clients reconnect. Readable by ADMIN, CONTROLLER and CAPTAIN.","operationId":"streamPacingSnapshots","parameters":[{"name":"serviceId","in":"query","description":"Only include this bus service","required":false,"schema":{"type":"string","maxLength":20,"minLength":0}},{"name":"vehicleReference","in":"query","description":"Only include this vehicle reference","required":false,"schema":{"type":"string","maxLength":80,"minLength":0}}],"responses":{"200":{"description":"Event stream of pacing snapshots","content":{"text/event-stream":{"schema":{"$ref":"#/components/schemas/PacingSnapshotResponse"}}}},"401":{"description":"Missing or invalid bearer token"},"403":{"description":"Role is not ADMIN, CONTROLLER or CAPTAIN"},"503":{"description":"The stream has reached its subscriber limit","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/pacing-snapshots/latest":{"get":{"tags":["Pacing"],"summary":"Get the most recent pacing snapshot","description":"Returns the latest calculated gaps once. Readable by ADMIN, CONTROLLER and CAPTAIN.","operationId":"getLatestPacingSnapshot","parameters":[{"name":"serviceId","in":"query","description":"Only include this bus service","required":false,"schema":{"type":"string","maxLength":20,"minLength":0}},{"name":"vehicleReference","in":"query","description":"Only include this vehicle reference","required":false,"schema":{"type":"string","maxLength":80,"minLength":0}}],"responses":{"200":{"description":"Latest snapshot, possibly with no items","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PacingSnapshotResponse"}}}},"401":{"description":"Missing or invalid bearer token"},"403":{"description":"Role is not ADMIN, CONTROLLER or CAPTAIN"},"503":{"description":"No snapshot has been calculated yet","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/live-bunching-alerts":{"get":{"tags":["Live bunching alerts"],"summary":"List current live bunching detections for the demo page","operationId":"listCurrentLiveBunchingAlertsFromIngestion","parameters":[{"name":"page","in":"query","description":"Zero-based page number","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","description":"Maximum alerts per page (1-200)","required":false,"schema":{"type":"integer","format":"int32","default":50,"maximum":200,"minimum":1}}],"responses":{"200":{"description":"Current live alerts returned, possibly empty","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LiveBunchingAlertPageResponse"}}}},"503":{"description":"Bunching alert service is unavailable","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/feed-status":{"get":{"tags":["Ingestion"],"summary":"List polling health for each configured stop","operationId":"listFeedStatuses","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/FeedStatusResponse"}}}}}}}},"/api/v1/demo-runs/{id}":{"get":{"tags":["Demo runs"],"summary":"Get run status and simulation alerts","description":"Closed and failed runs older than the configured operational retention window return 404, including before physical cleanup. Active replay runs remain available.","operationId":"getDemoRun","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Run status returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRunResponse"}}}},"404":{"description":"Demo run not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRunResponse"}}}},"503":{"description":"Bunching status is unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRunResponse"}}}}}}},"/api/v1/demo-runs/{id}/recommendation":{"get":{"tags":["Demo runs"],"summary":"Get the recommendation produced for a simulation bunching event","operationId":"getDemoRecommendation","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Recommendation output returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRecommendationResponse"}}}},"204":{"description":"Recommendation is still being generated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRecommendationResponse"}}}},"404":{"description":"Demo run not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemoRecommendationResponse"}}}},"503":{"description":"Recommendation service is unavailable","content":{"application/json":{"schema":{"$ref":"#/compo